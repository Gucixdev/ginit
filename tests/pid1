#!/bin/sh
# pid1 - ginit as the real PID 1, inside a private user+pid+mount namespace (unshare -Urpf), so nothing outside is touched.
# Checks: orphans are reaped (no zombie stays), the shutdown path logs and ends the other processes. reboot(2) itself is
# refused there (no CAP_SYS_BOOT on the host), which is the point: the machine is safe; that last syscall stays untested.
# Skips (exit 0) without unshare or when user namespaces are off.   usage: sh tests/pid1
cd "$(dirname "$0")/.." || exit 1
BIN=${BIN:-$PWD/build}
[ -x "$BIN/ginit" ] && [ -x "$BIN/ginitctl" ] || { echo "build first: make"; exit 1; }
command -v unshare > /dev/null && unshare -Urpf --mount-proc true 2> /dev/null || { echo "pid1 tests: no user/pid namespaces, skipped"; exit 0; }

T=$(mktemp -d) || exit 1
NSPID=
cleanup() { [ -n "$NSPID" ] && kill "$NSPID" 2> /dev/null; rm -rf "$T"; }
trap cleanup EXIT INT TERM
mkdir -p "$T/d"
cat > "$T/d/boot" <<EOF
type = internal
depends-on = chk
EOF
# an orphan: the subshell leaves, the sleeper is adopted by PID 1 and exits 0.3 s later
cat > "$T/d/orph" <<EOF
type = scripted
command = sh -c '(sleep 0.3 &) ; exit 0'
EOF
# long after the orphan ended: list every zombie of this namespace
cat > "$T/d/chk" <<EOF
type = scripted
depends-on = orph
command = sh -c 'sleep 1.5; for f in /proc/[0-9]*/status; do grep -q "^State:.Z" "\$f" && echo zombie; done > $T/zombies; echo done >> $T/zombies'
EOF

pass=0 fail=0
ok()  { pass=$((pass + 1)); }
bad() { fail=$((fail + 1)); echo "FAIL $1"; }

unshare -Urpf --kill-child --mount-proc "$BIN/ginit" -d "$T/d" -p "$T/sock" boot > "$T/log" 2>&1 &
NSPID=$!
i=0; while [ $i -lt 100 ] && ! grep -q '^done$' "$T/zombies" 2> /dev/null; do sleep 0.1; i=$((i + 1)); done

grep -q '^done$' "$T/zombies" 2> /dev/null && ok || bad "the check service ran"
grep -q 'pid 1' "$T/log" && ok || bad "ginit knows it is PID 1"
[ "$(grep -c zombie "$T/zombies" 2> /dev/null)" = 0 ] && ok || bad "an orphan stayed a zombie ($(grep -c zombie "$T/zombies"))"

"$BIN/ginitctl" -p "$T/sock" shutdown poweroff > /dev/null 2>&1
i=0; while [ $i -lt 40 ] && ! grep -q 'shutting down' "$T/log"; do sleep 0.1; i=$((i + 1)); done
grep -q 'shutting down' "$T/log" && ok || bad "shutdown began"

echo "pid1: $pass passed, $fail failed"
[ "$fail" -eq 0 ]

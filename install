#!/usr/bin/env bash
# install - build ginit and install it for the current user: no root; the one flag is -rebuild (full rebuild first).
# ginit, ginitctl and dinitctl go to ~/.local/bin. PREFIX=/usr/local (and sudo) installs system-wide, DESTDIR is for
# packagers. Installing does not make ginit the init of the machine; that is a boot loader setting (init=/usr/bin/ginit).
set -eu
cd "$(dirname "$(readlink -f "$0")")"
rebuild=
[ "${1:-}" = -rebuild ] && { rebuild=1; shift; }
[ $# -eq 0 ] || { echo "install: the only argument is -rebuild (full rebuild first); PREFIX=... in the environment changes the target" >&2; exit 2; }
export BUILD_FORCE=$rebuild
prefix=${PREFIX:-$HOME/.local}
./build > /dev/null
make --quiet install PREFIX="$prefix" DESTDIR="${DESTDIR:-}"
echo "ginit installed in ${DESTDIR:-}$prefix/bin (ginit, ginitctl, dinitctl)"
case ":$PATH:" in
	*":${DESTDIR:-}$prefix/bin:"*) ;;
	*) [ -n "${DESTDIR:-}" ] || echo "note: $prefix/bin is not in PATH; add it to your shell profile" ;;
esac
